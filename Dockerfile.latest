# notext — rebuilds the sources at container startup, so the image never has
# to be replaced: latest code is fetched (bind mount /src or GIT_SRC) and
# built fresh on every run.
FROM node:22-alpine

RUN apk add --no-cache git
COPY docker-entrypoint.sh /entrypoint.sh

WORKDIR /app

ENV NODE_ENV=production \
    PORT=4000 \
    ORIGIN=http://localhost:4000

EXPOSE 4000
VOLUME ["/app/data"]

ENTRYPOINT ["/entrypoint.sh"]
